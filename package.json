{
  "name": "toolshub",
  "version": "1.0.0",
  "description": "Cross-platform tools hub framework",
  "main": "dist/main/index.js",
  "author": "ToolsHub Team",
  "license": "MIT",
  "scripts": {
    "dev": "npm run generate:plugins && concurrently \"npm run dev:main\" \"npm run dev:renderer\"",
    "dev:main": "tsc -p tsconfig.main.json && cross-env NODE_ENV=development electron .",
    "dev:renderer": "vite",
    "build": "npm run generate:plugins && npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "generate:plugins": "npx ts-node scripts/generate-plugin-registry.ts",
    "docs": "typedoc",
    "package": "npm run build && electron-builder",
    "package:mac": "npm run build && electron-builder --mac",
    "package:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "better-sqlite3": "^9.2.2",
    "electron-store": "^8.1.0",
    "global-agent": "^3.0.0",
    "https-proxy-agent": "^7.0.6",
    "undici": "^7.16.0",
    "youtube-transcript": "^1.0.6",
    "youtubei.js": "^16.0.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^20.10.6",
    "@types/react": "^18.2.46",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^39.2.1",
    "electron-builder": "^24.9.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ts-node": "^10.9.2",
    "typedoc": "^0.25.7",
    "typescript": "^5.3.3",
    "vite": "^5.0.10",
    "vite-plugin-electron": "^0.28.1"
  }
}
